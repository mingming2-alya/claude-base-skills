{
  "version": "4.7",
  "note": "風格 × 動態一體化資料庫。全部 12 款風格皆支援淺／深雙底（用色鎖規則不鎖色碼）並各自綁定專屬動態 DNA（Motion DNA）；目前已就緒 4 款完整 Style & Motion DNA（counsel／apple／illustration／workday），其餘 8 款已預定動態個性，將於 Phase D 補齊完整憲法。主題→風格的推薦以 references/contexts.md〈主題類型總表〉為唯一來源；best_for 只描述各風格擅長的題材，stage_fit 只是常用場合的參考，不拿來排除風格。assemble.py 會依實際用到的動態原語按需細粒度注入對應模組（未用到 0 KB）。",
  "motion_library": {
    "kits": {
      "motion-workday": {
        "style": "workday",
        "css": "modules/motion/workday-kit.css",
        "js": "modules/motion/workday-kit.js",
        "physics": "crisp-snap (zero overshoot, fast settle, clear focus hierarchy)",
        "primitives": [
          { "id": "ruler-progress", "attr": "data-ruler-progress", "label": "刻度尺阻尼推進＋目標達標亮燈" },
          { "id": "bento-expand", "attr": "data-bento-expand", "label": "看板卡片點擊展開＋同排壓暗聚焦" }
        ]
      },
      "motion-counsel": {
        "style": "counsel",
        "css": "modules/motion/counsel-kit.css",
        "js": "modules/motion/counsel-kit.js",
        "physics": "editorial-weight (authoritative acceleration, crisp brake, evidence first)",
        "primitives": [
          { "id": "rank-race", "attr": "data-rank-race", "label": "FLIP 排名攀升超車交換" },
          { "id": "odometer", "attr": "data-odometer", "label": "機械滾輪數字逐位精準煞停" },
          { "id": "rack-focus", "attr": "data-rack-focus", "label": "推鏡景深聚焦（非焦點微柔焦退後）" }
        ]
      },
      "motion-apple": {
        "style": "apple",
        "css": "modules/motion/apple-kit.css",
        "js": "modules/motion/apple-kit.js",
        "physics": "cinema-spring (dramatic anticipation, elastic settle, optical light follow-through)",
        "primitives": [
          { "id": "split-mask", "attr": "data-split-mask", "label": "文字裁切遮罩逐行拉起" },
          { "id": "spotlight-sweep", "attr": "data-spotlight-sweep", "label": "單次聚光掃字顯影（掃完即靜止，游標可探照）" },
          { "id": "depth-deck", "attr": "data-depth-deck", "label": "3D 景深疊卡甩牌翻面" },
          { "id": "colorize-wipe", "attr": "data-colorize-wipe", "label": "黑白柔焦→彩色光幕掃入揭曉" }
        ]
      },
      "motion-story": {
        "style": "illustration",
        "css": "modules/motion/story-kit.css",
        "js": "modules/motion/story-kit.js",
        "physics": "tactile-bounce (warm overshoot & settle, primary-to-secondary follow-through)",
        "primitives": [
          { "id": "popup-fold", "attr": "data-popup-fold", "label": "立體書 3D 翻折立起＋主從彈性落位" },
          { "id": "chat-replay", "attr": "data-chat-replay", "label": "對話氣泡實況劇院（含輸入脈動）" }
        ]
      }
    },
    "external_adapters": {
      "contract": "references/motion-system.md#7",
      "policy": "預設 0 外部依賴、100% 離線可播；僅當旗艦專案明確需要異形變形、WebGL 3D 或外部動效片段 Remix 時，徵得使用者同意後掛接並遵守 deck:slideenter / deck:slideleave / staticMode 生命週期契約。",
      "supported_sources": [
        { "id": "motion-dev", "url": "https://motion.dev/examples", "role": "進階物理彈簧、手勢拖曳與 WebGL 互動參考／外接庫" },
        { "id": "motionface", "url": "https://motionface.cc/", "role": "場景敘事與 Remotion／HTML 動效片段參考與主題 Remix 來源" },
        { "id": "disney-12", "role": "內化至 references/motion-system.md 之動作分層、過衝回正與非對稱節奏心法" }
      ]
    }
  },
